package com.tap;

import java.io.IOException;
import java.io.PrintWriter;

import javax.servlet.RequestDispatcher;
import javax.servlet.ServletException;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import org.apache.jasper.compiler.Node.ForwardAction;

public class Servlet1 extends HttpServlet{

	static int count=3;
	@Override
	protected void service(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {
		
		resp.setContentType("text/html");
		
		String upass = req.getParameter("password");
		
		PrintWriter pw = resp.getWriter();
		
		RequestDispatcher rd = req.getRequestDispatcher("index.html");
		
		
		HttpSession ses = req.getSession();
		
		ses.setAttribute("uname", req.getParameter("username"));
		
		if("vpc123".equals(upass))
		{
			pw.print("WELCOME LOGIN SUCCESSFULL");
		}
		else if(count>0)
		{
			
			rd.include(req, resp);
			pw.print("INVALID LOGIN "+count+" ATTEMPTS LEFT");
			count--;
		}
		else if(count==0)
		{
			resp.sendRedirect("callingServlet2");
		}
	}

}
