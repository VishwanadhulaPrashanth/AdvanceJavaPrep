CREATE DEFINER=`root`@`localhost` PROCEDURE `employee_count`(IN d VARCHAR(10), OUT e_count INT)
BEGIN
SELECT COUNT(*) INTO e_count FROM `EMPLOYEE` WHERE `dept`=d;
END

