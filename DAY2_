import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import java.util.Scanner;

public class Demo6 {

	private static final Scanner sc = new Scanner(System.in);
	
	public static void main(String[] args) {

		String url ="jdbc:mysql://localhost:3306/jdbcclass";
		String uname="root";
		String upass="root";
		
		String query = "INSERT INTO EMPLOYEE (id,name,email,dept,salary) VALUES (?,?,?,?,?)";
		
		try {
			Class.forName("com.mysql.cj.jdbc.Driver");
			Connection con = DriverManager.getConnection(url,uname,upass);
			PreparedStatement pstmt = con.prepareStatement(query);
			
			System.out.println("Enter Id : ");
			Integer empId = Integer.parseInt(sc.nextLine());
			
			System.out.println("Enter Name : ");
			String empName = (sc.nextLine());
			
			System.out.println("Enter Email : ");
			String empMail = (sc.nextLine());
			
			System.out.println("Enter Department : ");
			String empDepartment = (sc.nextLine());
			
			System.out.println("Enter Salary : ");
			Integer empSal = Integer.parseInt(sc.nextLine());
			
			pstmt.setInt(1, empId);
			pstmt.setString(2, empName);
			pstmt.setString(3, empMail);
			pstmt.setString(4, empDepartment);
			pstmt.setInt(5, empSal);
			
			int row = pstmt.executeUpdate();
			
			System.out.println(row);
		} catch (ClassNotFoundException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		
		
	}

}

